Host *
  IdentityAgent ~/.1password/agent.sock
  IdentitiesOnly yes
  AddKeysToAgent no

# ──────────────────────────────────────
# GitHub
# ──────────────────────────────────────

Host github.com
  HostName github.com
  User git
  RequestTTY no
  IdentityFile ~/.ssh/keys/github-personal.pub

Host github-personal
  HostName github.com
  User git
  RequestTTY no
  IdentityFile ~/.ssh/keys/github-personal.pub

Host github-work
  HostName github.com
  User git
  RequestTTY no
  IdentityFile ~/.ssh/keys/github-work.pub

